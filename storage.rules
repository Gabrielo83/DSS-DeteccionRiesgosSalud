rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn()
        ? firestore.get(
            /databases/(default)/documents/usuarios/$(request.auth.uid)
          ).data.rol
        : "";
    }

    function hasAnyRole(roles) {
      return signedIn() && role() in roles;
    }

    function isClinical() {
      return hasAnyRole(["superAdmin", "medico", "administrativoSalud"]);
    }

    function canUploadCertificate() {
      return hasAnyRole([
        "superAdmin",
        "medico",
        "administrativoSalud"
      ]);
    }

    function isAllowedCertificateFile() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          "application/pdf",
          "image/jpeg",
          "image/png"
        ];
    }

    function isOwnedUpload() {
      return request.resource != null
        && request.resource.metadata.uploaderUid == request.auth.uid;
    }

    function isOwnedReplacement() {
      return resource != null
        && resource.metadata.uploaderUid == request.auth.uid
        && isOwnedUpload();
    }

    match /certificados/{reference}/{fileName} {
      allow read: if isClinical();
      allow create: if canUploadCertificate()
        && isAllowedCertificateFile()
        && isOwnedUpload();
      allow update: if canUploadCertificate()
        && isAllowedCertificateFile()
        && isOwnedReplacement();
      allow delete: if hasAnyRole(["superAdmin"]);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

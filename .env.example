# --- Modo de datos ---
# local: usa localStorage/IndexedDB. firebase: sincroniza operaciones con Firebase.
VITE_DATA_PROVIDER="local"

# --- Firebase Project (reemplaza con tus credenciales reales) ---
VITE_FIREBASE_API_KEY="tu_api_key"
VITE_FIREBASE_AUTH_DOMAIN="tu_proyecto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tu_proyecto"
VITE_FIREBASE_STORAGE_BUCKET="tu_proyecto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:abcdef123456"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Habilitar solo en equipos institucionales o personales confiables.
# Conserva la cache de Firestore entre sesiones para continuidad offline.

# Cachea el shell de la aplicacion en builds de produccion para apertura offline.
VITE_ENABLE_OFFLINE_SHELL="false"


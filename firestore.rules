rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function role() {
      return signedIn() && userDoc().data.rol is string
        ? userDoc().data.rol
        : "";
    }

    function hasAnyRole(roles) {
      return signedIn() && role() in roles;
    }

    function isClinical() {
      return hasAnyRole(["superAdmin", "medico", "administrativoSalud"]);
    }

    function isMedicalReviewer() {
      return hasAnyRole(["superAdmin", "medico"]);
    }

    function isOperational() {
      return hasAnyRole([
        "superAdmin",
        "medico",
        "administrativo",
        "administrativoSalud",
        "respRRHH"
      ]);
    }

    function canManageCertificateIntake() {
      return hasAnyRole([
        "superAdmin",
        "medico",
        "administrativoSalud"
      ]);
    }

    function ownsExistingDocument() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function ownsRequestedDocument() {
      return signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    function ownsLegacyOperation() {
      return signedIn()
        && !resource.data.keys().hasAny(["ownerUid"])
        && resource.data.user is string
        && resource.data.user == request.auth.token.email;
    }

    function isValidOperationDocument(operationId) {
      return request.resource.data.keys().hasOnly([
          "id",
          "type",
          "user",
          "ownerUid",
          "entityId",
          "localCreatedAt",
          "retryCount",
          "syncStatus",
          "syncError",
          "attemptedAt",
          "syncedAt"
        ])
        && request.resource.data.id == operationId
        && request.resource.data.type is string
        && request.resource.data.ownerUid == request.auth.uid;
    }

    function canAdoptLegacyDraftAsAdmin() {
      return hasAnyRole(["superAdmin"])
        && !resource.data.keys().hasAny(["ownerUid"])
        && request.resource.data.ownerUid is string
        && exists(/databases/$(database)/documents/usuarios/$(request.resource.data.ownerUid))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["ownerUid", "updatedAt"]);
    }

    function isValidUserProfile(uid) {
      return request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "nombreVisible",
          "rol",
          "creadoEn",
          "actualizadoEn"
        ])
        && request.resource.data.email is string
        && request.resource.data.nombreVisible is string
        && request.resource.data.rol is string
        && request.resource.data.rol in [
          "superAdmin",
          "medico",
          "administrativo",
          "administrativoSalud",
          "respRRHH",
          "gerente"
        ]
        && (!request.resource.data.keys().hasAny(["uid"])
          || request.resource.data.uid == uid);
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || hasAnyRole(["superAdmin"]));
      allow create, update: if hasAnyRole(["superAdmin"])
        && isValidUserProfile(uid);
      allow delete: if hasAnyRole(["superAdmin"]);
    }

    match /empleados/{employeeId} {
      allow read: if isOperational();
      allow create, update, delete: if hasAnyRole(["superAdmin", "respRRHH"]);
    }

    match /ausencias/{absenceId} {
      allow read: if isOperational();
      allow create, update: if isOperational();
      allow delete: if hasAnyRole(["superAdmin"]);
    }

    match /validaciones_medicas/{reference} {
      allow read: if isClinical();
      allow create: if canManageCertificateIntake();
      allow update: if isMedicalReviewer()
        || (canManageCertificateIntake()
          && resource.data.estado in ["pendiente", "en_revision", "Pendiente", "En Revision"]);
      allow delete: if hasAnyRole(["superAdmin"]);
    }

    match /historial_medico/{historyId} {
      allow read: if isClinical();
      allow create, update: if isMedicalReviewer();
      allow delete: if hasAnyRole(["superAdmin"]);
    }

    match /borradores/{draftId} {
      allow read: if hasAnyRole(["superAdmin"]) || ownsExistingDocument();
      allow create: if isOperational() && ownsRequestedDocument();
      allow update: if (isOperational()
          && ownsExistingDocument()
          && ownsRequestedDocument())
        || canAdoptLegacyDraftAsAdmin();
      allow delete: if hasAnyRole(["superAdmin"])
        || (isOperational() && ownsExistingDocument());
    }

    match /planes_preventivos/{employeeId} {
      allow read: if isClinical();
      allow create, update: if isMedicalReviewer();
      allow delete: if hasAnyRole(["superAdmin"]);
    }

    match /patologias/{pathologyId} {
      allow read: if signedIn();
      allow create, update, delete: if hasAnyRole(["superAdmin", "medico"]);
    }

    match /parametros_riesgo/{configId} {
      allow read: if signedIn();
      allow create, update, delete: if hasAnyRole(["superAdmin", "medico"]);
    }

    match /alertas_riesgo/{alertId} {
      allow read: if isClinical();
      allow create, update, delete: if false;
    }

    match /indicadores_alertas/{indicatorId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /indicadores_riesgo/{indicatorId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /indicadores_ausentismo/{indicatorId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /auditoria/{auditId} {
      allow read: if hasAnyRole(["superAdmin"]);
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /operations/{operationId} {
      allow read: if hasAnyRole(["superAdmin"]) || ownsExistingDocument();
      allow create: if isValidOperationDocument(operationId);
      allow update: if isValidOperationDocument(operationId)
        && (ownsExistingDocument() || ownsLegacyOperation());
      allow delete: if hasAnyRole(["superAdmin"]);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
